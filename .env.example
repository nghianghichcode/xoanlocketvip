# ===== CẤU HÌNH BOT TELEGRAM =====
# Lấy token từ @BotFather trên Telegram
BOT_TOKEN=your_bot_token_here

# ===== ADMIN TELEGRAM =====
# Điền Telegram User ID của bạn (nhắn tin @userinfobot để lấy ID)
ADMIN_ID=123456789

# ===== NEXTDNS API KEY =====
# Lấy tại: https://my.nextdns.io/account
NEXTDNS_KEY=your_nextdns_api_key_here

# ===== URL CÀI DNS TÙY CHỈNH =====
# Có thể dùng tinyurl hoặc bất kỳ URL redirect nào.
# Nếu bạn đã có link profile sẵn thì chỉ cần gán trực tiếp vào đây.
NEXTDNS_INSTALL_URL=https://tinyurl.com/45z362ae

# ===== CẤU HÌNH THANH TOÁN / SEPAY =====
# Điền thông tin API/merchant từ ngân hàng hoặc cổng thanh toán của bạn.
# Nếu sử dụng template URL, hãy để các placeholder sau:
#   {merchant_id}, {order_id}, {amount}
SEPAY_MERCHANT_ID=your_merchant_id_here
SEPAY_SECRET_KEY=your_secret_key_here
SEPAY_API_TOKEN=your_api_token_here
SEPAY_ENV=production
SEPAY_IPN_SECRET=your_ipn_secret_here
SEPAY_PAYMENT_URL_TEMPLATE=https://your-sepay-domain.com/pay?merchant={merchant_id}&order={order_id}&amount={amount}
# Nếu cổng của bạn dùng biến URL khác hoặc bản đồ link, hãy gán trực tiếp giá trị URL ở đây.

# ===== GIỚI HẠN VÀ MỨC PHÍ =====
PAYMENT_UNLOCK_AMOUNT=20000
PAYMENT_UNLOCK_DAYS=7
WEEKLY_USAGE_LIMIT=1
