# ===== CẤU HÌNH BOT TELEGRAM =====
# Lấy token từ @BotFather trên Telegram
BOT_TOKEN=your_bot_token_here

# ===== ADMIN TELEGRAM =====
# Điền Telegram User ID của bạn (nhắn tin @userinfobot để lấy ID)
ADMIN_ID=123456789

# ===== NEXTDNS API KEY =====
# Lấy tại: https://my.nextdns.io/account
NEXTDNS_KEY=your_nextdns_api_key_here

# ===== URL CÀI DNS TÙY CHỈNH =====
# Có thể dùng tinyurl hoặc bất kỳ URL redirect nào.
# Nếu bạn đã có link profile sẵn thì chỉ cần gán trực tiếp vào đây.
NEXTDNS_INSTALL_URL=https://tinyurl.com/45z362ae

# ===== THANH TOÁN VIETQR + WEBHOOK SEPAY =====
# Mã ngân hàng có thể là BIN (VD 970436) hoặc code (VD VCB).
VIETQR_BANK_BIN=970436
VIETQR_ACCOUNT_NO=your_bank_account_number
VIETQR_ACCOUNT_NAME=NGUYEN VAN A

# Tạo một chuỗi bí mật mạnh và nhập cùng giá trị này khi tạo webhook API Key trên SePay.
SEPAY_WEBHOOK_API_KEY=replace_with_a_long_random_secret
# Token tại SePay > Cấu hình công ty > API Access, dùng để đối soát khi webhook trễ.
SEPAY_API_TOKEN=replace_with_your_sepay_api_token
# Tiền tố chỉ gồm chữ/số, cần dùng cùng tiền tố khi lọc Mã thanh toán trên SePay.
PAYMENT_ORDER_PREFIX=XOAN

# Railway Postgres tự cấp DATABASE_URL khi liên kết database vào service.
DATABASE_URL=

# ===== GIỚI HẠN VÀ MỨC PHÍ =====
PAYMENT_UNLOCK_AMOUNT=20000
PAYMENT_UNLOCK_DAYS=7
PAYMENT_UNLOCK_USES=3
SHARE_UNLOCK_USES=1
WEEKLY_USAGE_LIMIT=1

# ===== LIÊN HỆ & ỦNG HỘ TRÊN WEBSITE =====
SUPPORT_FACEBOOK_URL=https://facebook.com/ten-trang-cua-ban
SUPPORT_TELEGRAM_URL=https://t.me/ten-tai-khoan-cua-ban
DONATE_TRANSFER_CONTENT=UNG HO XOAN
# Chạy local chỉ với website: đặt cả hai biến thành false
RUN_BOT=true
RUN_RENEW_DAEMON=true
